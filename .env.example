# MM-MentalHealth AI - Environment Variables
# Copy this file to .env and fill in any values as needed.
# This app runs fully offline — no external API keys are required.

# Optional: Override the Streamlit server port (default: 8501)
# STREAMLIT_SERVER_PORT=8501

# Optional: Override the Streamlit server address (default: localhost)
# STREAMLIT_SERVER_ADDRESS=localhost

# Optional: Suppress TensorFlow verbose GPU/CPU logs (already set in code)
# TF_CPP_MIN_LOG_LEVEL=3
